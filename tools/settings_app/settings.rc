#include <windows.h>

1 24 "settings.manifest"
1 ICON "../../assets/icon.ico"
IDI_APP_ICON ICON "../../assets/icon.ico"
IDB_LOGO_SIDEBAR BITMAP "../../assets/logo_sidebar.bmp"
IDB_LOGO_ABOUT BITMAP "../../assets/logo_about.bmp"

1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS__WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "AH Creations\0"
            VALUE "FileDescription", "Likhi (লিখি) — Settings & Dashboard\0"
            VALUE "FileVersion", "1.0.0.0\0"
            VALUE "InternalName", "bangla_settings\0"
            VALUE "LegalCopyright", "Copyright (C) 2026 AH Creations\0"
            VALUE "OriginalFilename", "bangla_settings.exe\0"
            VALUE "ProductName", "Likhi (লিখি)\0"
            VALUE "ProductVersion", "1.0.0.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
