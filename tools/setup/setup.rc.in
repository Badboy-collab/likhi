#include <windows.h>

// Must match the constants in setup_main.cpp
#define IDR_PAYLOAD_DLL      101
#define IDR_PAYLOAD_LEX      102
#define IDR_PAYLOAD_SETTINGS 103

// ---- Manifest (UAC: requireAdministrator) --------------------------------
1 RT_MANIFEST "@CMAKE_SOURCE_DIR@/tools/setup/setup.manifest"

// ---- Embedded payload ----------------------------------------------------
// The installer is a SINGLE self-contained .exe: the IME DLL, the compiled
// lexicon and the Settings app travel inside it as binary resources.
IDR_PAYLOAD_DLL      RCDATA "@SETUP_PAYLOAD_DLL@"
IDR_PAYLOAD_LEX      RCDATA "@SETUP_PAYLOAD_LEX@"
IDR_PAYLOAD_SETTINGS RCDATA "@SETUP_PAYLOAD_SETTINGS@"

IDI_LIKHI ICON "@CMAKE_SOURCE_DIR@/assets/icon.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Likhi\0"
      VALUE "FileDescription", "Likhi - one-click installer\0"
      VALUE "FileVersion", "1.0.0.0\0"
      VALUE "InternalName", "likhi_setup\0"
      VALUE "OriginalFilename", "LikhiSetup.exe\0"
      VALUE "ProductName", "Likhi - PC Bangla Typing App\0"
      VALUE "ProductVersion", "1.0.0\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
